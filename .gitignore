# ---------------------------------------------------------------------------
# MustafaFil — depoya girmeyecekler
# Ölçü: KAYNAK depoya girer; üretilen, indirilen ve makineye ait olan girmez.
# ---------------------------------------------------------------------------

# .NET yapı çıktısı — "dotnet build" her seferinde yeniden üretir.
# wwwroot kopyası da bunun içinde (sunucu/bin/Debug/net8.0/wwwroot).
bin/
obj/
*.user

# UYGULAMA VERİSİ — makineye aittir, paylaşılmaz.
# gunluk-veriler: günlük JSON yedekleri (fabrikanın gerçek rakamları).
# veri/ + *.db: SQLite veritabanı ve yan dosyaları.
# mail-hesaplari.json: DPAPI ile şifreli SMTP parolası — asla depoya girmez.
gunluk-veriler/
veri/
yedek/
mail-hesaplari.json
*.db
*.db-shm
*.db-wal

# Windows
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store

# Editör / IDE
.vscode/
.idea/
*.swp

# Python - yan-urunler-sunucu.py modul onbellegi
__pycache__/
*.pyc

# Node
node_modules/
npm-debug.log*

# Araç meta verisi (Serena) — proje dosyası değil, yerel indeks.
.serena/

# Claude Code yerel ayarlar (makineye özel izinler)
.claude/settings.local.json

# Geçici dosyalar
*.tmp
*.log

# Ortak veri paketi (gelistirme sunucusu) — gercek veridir, depoya girmez.
veri-paket.json

# ---------------------------------------------------------------------------
# BELGELER DEPOYA GİRMEZ (kullanıcı isteği, 03.09.2026)
# Depoda yalnız ÇALIŞAN kod durur: js, css, html, cs, py.
# Not, plan, sözleşme ve şartname makinede kalır; git'e gitmez.
# ---------------------------------------------------------------------------
*.md
*.txt
*.docx

# Şartname — hem Word hâli hem HTML hâli hem düz metni.
docs/yan-urunler-sartname-v2.html
sartname*
