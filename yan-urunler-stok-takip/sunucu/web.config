<?xml version="1.0" encoding="utf-8"?>
<!--
  Yan Ürünler Stok Takip — ASP.NET Core yayını için IIS yapılandırması.

  BU DOSYA KAYNAKTIR, YAYIN ÇIKTISI DEĞİL. "dotnet publish" sırasında
  Microsoft.NET.Sdk.Web bu dosyayı DÖNÜŞTÜRÜR ve şunları kendisi ekler:
    - AspNetCoreModuleV2 handler
    - processPath="dotnet"
    - arguments=".\YanUrunler.Sunucu.dll"
  Bu üç değer buraya ELLE YAZILMAZ; DLL adı publish çıktısından doğrulanır.
  (IIS-VE-ORTAK-KULLANIM.md §6)

  Kök klasördeki ..\web.config ile karıştırılmamalıdır: o dosya YALNIZ
  statik yayın (index.html + css + js, sunucu yok) içindir ve publish
  çıktısına kopyalanmaz (csproj Content beyaz listesi).

  Buraya yalnız KODDAN DOĞRULANMIŞ ihtiyaçlar girer. Projede WebSocket,
  SignalR ve SPA yol yönlendirmesi YOKTUR; o ayarlar bilerek eklenmemiştir.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>

      <!-- WEBDAV KALDIRILIR — ZORUNLU.
           Program.cs:256 "app.MapDelete(\"/api/mail/hesap\", ...)" tanımlı.
           IIS'in WebDAV modülü kuruluysa DELETE isteklerini kendi üstlenir ve
           uygulamaya hiç ulaşmadan 405 döner. Mail hesabı silme özelliği
           localhost'ta çalışır, IIS'te çalışmazdı. Modül kurulu değilse bu
           iki satır zararsızdır. -->
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
      </handlers>

      <aspNetCore stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <!-- Ayrıntılı hata sayfası ve yığın izi kullanıcıya GÖSTERİLMEZ. -->
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />

          <!-- GÜNLÜK JSON YEDEK KLASÖRÜ — VERİ KAYBINI ÖNLER.
               GunlukJsonYedek.KlasoruBul: ayar boşsa içerik kökünden yukarı
               doğru "yan-urunler-stok-takip" adlı klasör arar; IIS yayınında
               böyle bir klasör YOKTUR, bu yüzden yayın klasörünün içine
               "<site>\gunluk-veriler" düşer. Dağıtım robocopy /MIR ile
               yapıldığında (IIS-VE-ORTAK-KULLANIM.md §2.2) o klasör her
               yayında SİLİNİR. Yol burada uygulama dışına sabitlenir.
               appsettings.json'daki VeriDosyasi/YedekKlasoru ile aynı kök. -->
          <environmentVariable name="YanUrunler__GunlukYedekKlasoru" value="C:\YanUrunler\gunluk-veriler" />
        </environmentVariables>
      </aspNetCore>

      <security>
        <requestFiltering>
          <!-- 50 MB. Gerekçe kodda: POST /api/paket TÜM paketi tek gövdede
               yollar (bugün ~1,5 MB, üç sezonda birkaç MB) ve
               POST /api/gunluk-yedek manifest kaybında DEĞİŞEN TÜM gün
               dosyalarını tek istekte gönderir (07-yedekci · sirala).
               Python sunucusundaki EN_BUYUK_GOVDE ile aynı sınır. -->
          <requestLimits maxAllowedContentLength="52428800" />
        </requestFiltering>
      </security>

      <httpProtocol>
        <customHeaders>
          <!-- Üst seviyeden miras kalan aynı adlı girişler önce kaldırılır:
               çift başlık ve duplicate-entry riski. -->
          <remove name="X-Powered-By" />

          <remove name="X-Content-Type-Options" />
          <add name="X-Content-Type-Options" value="nosniff" />

          <remove name="X-Frame-Options" />
          <add name="X-Frame-Options" value="DENY" />

          <remove name="Referrer-Policy" />
          <add name="Referrer-Policy" value="no-referrer" />

          <remove name="Permissions-Policy" />
          <add name="Permissions-Policy" value="geolocation=(), camera=(), microphone=()" />

          <!-- CSP değerleri koddan doğrulandı:
               blob:       -> CSV/Excel/JSON/PDF indirmeleri URL.createObjectURL
                              kullanıyor (10-kabuk:1589,1647 · 35-mail:691 ·
                              36-excel:491).
               unsafe-inline (script) -> index.html açılış tema betiği.
               unsafe-inline (style)  -> arayüz ve yazdırma penceresi satır içi
                              stil üretiyor.
               connect-src -> saat eşitlemesi timeapi.io ve cloudflare'e
                              gidiyor (01-cekirdek:197,205); 'self' ise
                              /api/* çağrıları.
               form-action 'none' -> projede hiç <form> yok, doğrulandı. -->
          <remove name="Content-Security-Policy" />
          <add name="Content-Security-Policy"
               value="default-src 'self' blob:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self' https://timeapi.io https://www.cloudflare.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'" />
        </customHeaders>
      </httpProtocol>

      <!--
        BİLEREK EKLENMEYENLER (in-process barındırmada iş görmezler ya da
        gereksizdir; eklenirse yanlış güven verirler):

        defaultDocument  : Program.cs "app.UseDefaultFiles()" çağırıyor.
        staticContent    : statik dosyaları IIS değil, StaticFiles ara katmanı
                           sunuyor; Cache-Control zaten Program.cs'te
                           "no-cache, must-revalidate" olarak veriliyor.
        directoryBrowse  : dizin listeleme ara katmanı hiç kurulmuyor.
        rewrite (SPA)    : arayüz HASH yönlendirme kullanıyor (#/kuru-kuspe);
                           tarayıcı "#" sonrasını sunucuya göndermez, bu
                           yüzden yenilemede 404 oluşmaz. URL Rewrite modülü
                           kurulu değilse rewrite kuralı 500.19 üretirdi.
        httpRedirect/HSTS: HTTPS zorunluluğu bağlama (binding) ve sertifika
                           işidir; web.config'e gömülürse düz HTTP ile test
                           imkânsızlaşır.
      -->
    </system.webServer>
  </location>
</configuration>
