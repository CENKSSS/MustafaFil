<?xml version="1.0" encoding="utf-8"?>
<!--
  Yan Ürünler Stok Takip - mevcut statik prototip için IIS yapılandırması.

  Bu dosya yalnız index.html + css + klasik JavaScript sürümü içindir.
  Uygulama hash tabanlı yönlendirme kullandığından URL Rewrite gerekmez.

  Bu dosyaya AspNetCoreModuleV2, processPath veya uygulama DLL adı elle
  eklenmez. Blazor/ASP.NET Core sürümünün web.config dosyasını Microsoft.NET.Sdk.Web
  "dotnet publish" sırasında üretir. Bu statik dosya o yayına kopyalanmaz.

  HTTPS zorunludur: mevcut giriş akışı Web Crypto crypto.subtle kullanır.
  Üretimde istemcilerin güvendiği kurum içi CA veya güvenilir CA sertifikası
  kullanılmalıdır. Kendinden imzalı sertifika yalnız test/geçici kurulum içindir.

  Yayın beyaz listesi:
    index.html, web.config, css/, js/, ICON.png, LOGO.png, LOGO-koyu.png

  Kaynak dokümanları, PowerShell betikleri ve yan-panel-ornekleri.html yayın
  klasörüne kopyalanmaz. Aşağıdaki requestFiltering kuralları ikinci savunmadır.
-->
<configuration>
  <system.webServer>

    <!-- Kök isteği yalnız index.html'e yönelir. clear, üst düzey varsayılan
         belge koleksiyonuyla duplicate-entry/500.19 riskini önler. -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- Dosya adları içerik hash'i taşımadığı için tarayıcı her kullanımda
         sunucuya yeniden doğrular. ETag/304 kullanılmaya devam eder. -->
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <!-- Üst seviyeden miras kalan aynı adlı girişleri önce kaldırmak,
             duplicate-entry/çift başlık riskini azaltır. -->
        <remove name="X-Powered-By" />

        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />

        <remove name="X-Frame-Options" />
        <add name="X-Frame-Options" value="DENY" />

        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="no-referrer" />

        <remove name="Permissions-Policy" />
        <add name="Permissions-Policy" value="geolocation=(), camera=(), microphone=()" />

        <!-- unsafe-inline şu an bilinçli olarak korunur:
             - index.html açılış tema betiği kullanıyor,
             - arayüz JavaScript ile çok sayıda inline stil üretiyor,
             - yazdırma/mail ekranı dinamik stil oluşturuyor.
             Uygulama kodu ayrıştırılmadan kaldırılması ekranı bozabilir. -->
        <remove name="Content-Security-Policy" />
        <add name="Content-Security-Policy"
             value="default-src 'self' blob:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self' https://timeapi.io https://www.cloudflare.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'" />
      </customHeaders>
    </httpProtocol>

    <directoryBrowse enabled="false" />

    <security>
      <requestFiltering>
        <!-- web.config zaten IIS'in varsayılan hiddenSegments koleksiyonundadır;
             tekrar eklenmez. Aksi halde bazı sunucularda 500.19 oluşabilir. -->
        <hiddenSegments>
          <remove segment="yan-panel-ornekleri.html" />
          <add segment="yan-panel-ornekleri.html" />
        </hiddenSegments>

        <fileExtensions>
          <remove fileExtension=".md" />
          <add fileExtension=".md" allowed="false" />
          <remove fileExtension=".vbs" />
          <add fileExtension=".vbs" allowed="false" />
          <remove fileExtension=".ps1" />
          <add fileExtension=".ps1" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <!-- httpCompression sunucu seviyesinde yönetilir. Bu statik uygulamada
         IIS'in varsayılan statik sıkıştırma davranışı kullanılır. -->
  </system.webServer>
</configuration>
